# ------------------------------------------------------------------
# Laxyam Academy configuration
# Copy this file to `.env` and fill in real values.
# `.env` is blocked from web access by .htaccess - never commit it.
# Only variables prefixed with VITE_ are ever exposed to the browser bundle;
# never put secrets in a VITE_ variable.
# ------------------------------------------------------------------

# --- Application -------------------------------------------------
APP_NAME="Laxyam Academy"
# development | production
APP_ENV=development
APP_DEBUG=false
# Full public URL without trailing slash (used for emails, sitemap, canonical URLs)
APP_URL=http://localhost/laxyam
APP_TIMEZONE=Asia/Kolkata

# URL path the site is served from. "/" on a real domain, "/laxyam/" on local XAMPP.
VITE_APP_BASE=/laxyam/
# Where Apache/PHP is reachable while running `npm run dev`
VITE_DEV_PHP_ORIGIN=http://localhost

# --- Database ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=laxyam_academy
DB_USER=root
DB_PASS=

# --- Sessions ----------------------------------------------------
SESSION_NAME=laxyam_sid
# Lifetime in minutes
SESSION_LIFETIME=120

# --- Email (SMTP) - leave blank until configured -------------------
MAIL_FROM=info@laxyamacademy.com
MAIL_FROM_NAME="Laxyam Academy"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# tls | ssl | none
SMTP_SECURE=tls

# --- Payments - leave blank until configured -----------------------
# Gateway used for new checkouts: cashfree (recommended - the academy's live gateway, and the default when this
# line is missing) | razorpay. Existing orders keep the gateway they were created with.
PAYMENT_PROVIDER=cashfree
# sandbox (test keys, no real money) | live (production keys). Cashfree: sandbox -> https://sandbox.cashfree.com/pg,
# live -> https://api.cashfree.com/pg; the browser SDK mode follows automatically.
PAYMENT_MODE=sandbox

# Cashfree Payment Gateway: Merchant Dashboard -> Developers -> API Keys (App ID + Secret Key; sandbox and
# production keys are different). Server-side only - never use a VITE_ prefix.
# Keep convenience fees / surcharges OFF in the Cashfree dashboard: a payment must equal the order total exactly,
# otherwise access is not activated automatically and the order is held for staff review.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Optional. Cashfree signs webhooks with the Secret Key above (x-webhook-signature = base64 HMAC-SHA256 of
# timestamp + raw body), so this can stay empty; if set it is accepted as an additional signing key.
# Webhook URL to add in Cashfree -> Developers -> Webhooks: https://your-domain/api/webhooks.php?provider=cashfree
# (events: Success Payment, Failed Payment, User Dropped Payment).
CASHFREE_WEBHOOK_SECRET=
# Optional: x-api-version header (default 2025-01-01; 2023-08-01 ... 2026-01-01 use the same fields here).
CASHFREE_API_VERSION=
# Optional: reject webhooks whose timestamp is older/newer than this many seconds (default 600 = 10 minutes).
CASHFREE_WEBHOOK_TOLERANCE=
# Local testing only: point the API at a mock server (e.g. http://127.0.0.1:8787). Ignored when APP_ENV=production.
CASHFREE_API_BASE=

# Razorpay (when PAYMENT_PROVIDER=razorpay): Dashboard -> Settings -> API Keys / Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Uploads -----------------------------------------------------
# Maximum upload size in megabytes
UPLOAD_MAX_MB=20

# --- Optional integrations (leave empty to keep them off) ---
# Website chat assistant AI answers (admin -> Leads -> Chatbot -> Settings & AI).
# Without a key it still answers from your courses, tests and FAQs.
# OpenAI: platform.openai.com -> API keys (needs billing credit). Server-side only - never use a VITE_ prefix.
OPENAI_API_KEY=
# Optional: gpt-6-luna (default, fast and cheapest) or gpt-6.1-terra (smarter, costlier)
OPENAI_MODEL=
# Optional, only if the key belongs to several organisations
OPENAI_ORG_ID=
# Optional: openai or anthropic - which one to use when both keys are set (default openai)
CHATBOT_AI_PROVIDER=
# Claude (Anthropic) instead of OpenAI
ANTHROPIC_API_KEY=
# Optional: claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5
ANTHROPIC_MODEL=
# Spam protection (admin -> Settings -> Spam protection holds the public site key)
RECAPTCHA_SECRET=
# WhatsApp automation (admin -> Emails -> WhatsApp). Server-side only - never use a VITE_ prefix.
# Interakt (default provider): Interakt -> Settings -> Developer Settings -> Secret Key (paste exactly as shown;
# it is sent as "Authorization: Basic <key>").
INTERAKT_API_KEY=
# The Secret Key you type in Interakt's webhook settings; verifies the Interakt-Signature header on
# https://your-domain/api/whatsapp-webhook.php (delivery / read / failed status updates).
INTERAKT_WEBHOOK_SECRET=
# Optional: only for local testing against a mock server (default https://api.interakt.ai)
INTERAKT_API_BASE=
# Meta WhatsApp Cloud API (only when admin -> WhatsApp -> Settings -> Provider = Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Google Search Console service-account key file (or upload it in admin -> Indexing Status)
GSC_SERVICE_ACCOUNT_FILE=
# S3-compatible private storage (admin -> Integrations -> Cloud Storage)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_KEY=
S3_SECRET=
S3_PATH_STYLE=1
# Emergency only: set to 1 if an IP allowlist / access hours lock every admin out
ADMIN_ACCESS_POLICY_OFF=0
